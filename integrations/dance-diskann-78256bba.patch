+__global__ void count_u8_flags_kernel(const uint8_t *flags, uint32_t N, unsigned long long *count)
+{
+    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row < N && flags[row] != 0)
+        atomicAdd(count, 1ull);
+}
