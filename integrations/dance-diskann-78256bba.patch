+static uint32_t env_u32_clamped(const char *name, uint32_t default_value, uint32_t min_value, uint32_t max_value)
+{
+    uint32_t value = default_value;
+    const char *env = getenv(name);
+    if (env && atoi(env) > 0)
+        value = (uint32_t)atoi(env);
+    if (value < min_value)
+        value = min_value;
+    if (value > max_value)
+        value = max_value;
+    return value;
+}
