+    #endif
+
+    #if ENABLE_DP4A_DISTANCE
+    if ((dim & 3u) == 0)
+        return warp_l2_distance_dp4a(data,dim,a,b,lane);
+    #endif
+
+    if ((dim & 3u) == 0)
+        return warp_l2_distance_uchar4(data,dim,a,b,lane);
