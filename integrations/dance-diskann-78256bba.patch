+        "DISKANN_GPU_FILTERED_BRIDGE_WORK_RESERVE", 8, 0, 16);
+    const uint32_t tau_F = env_u32_clamped(
+        "DISKANN_GPU_FILTERED_CANONICAL_TAU_F", 8, 1, R);
