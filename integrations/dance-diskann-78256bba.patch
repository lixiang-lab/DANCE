+                    }
+                    if (cudaDeviceSynchronize() != cudaSuccess)
+                        return -18;
+                    const auto group_end = std::chrono::steady_clock::now();
+                    pass2_group_truncate_seconds += seconds_since(group_start, group_end);
+
+                    const auto d2h_start = std::chrono::steady_clock::now();
