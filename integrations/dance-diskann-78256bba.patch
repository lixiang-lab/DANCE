+    float victim_dist = -FLT_MAX;
+#endif
+
+    for (uint32_t i = 0; i < deg; i++)
+    {
+        uint32_t y = row[i];
+
+        if (y == INVALID_ID || y >= N || y == node)
+            continue;
+
+        float d_py = dist_row[i];
+
+        if (d_py > worst_dist)
