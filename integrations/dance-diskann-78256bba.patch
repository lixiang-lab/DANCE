+    const size_t src_base = (size_t)src * C;
+
+    for (uint32_t start = 0; start < deg_src; start += WARP_SIZE)
+    {
+        uint32_t src_pos = start + lane;
+        uint32_t target = INVALID_ID;
+
+        if (src_pos < deg_src)
+            target = graph_next[src_base + src_pos];
