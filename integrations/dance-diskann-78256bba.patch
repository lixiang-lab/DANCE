+struct ShardInfo
+{
+    std::string graph_path;
+    std::string idmap_path;
+    std::vector<uint32_t> idmap;
+    uint32_t width = 0;
+    uint32_t medoid = 0;
+    uint64_t frozen = 0;
+    uint64_t edges = 0;
+};
