+            for (uint32_t s = 0; s < seeds; ++s)
+            {
+                uint32_t off = filtered_hash_u32(row * 0x9e3779b1u + lbl * 0x85ebca6bu + s * 0xc2b2ae35u) % pc;
+                uint32_t seed = label_points[pb + off];
