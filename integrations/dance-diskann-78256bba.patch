+    const uint32_t fused_label_threshold = fused_threshold_env ?
+        std::min(64u, (uint32_t)std::max(0, atoi(fused_threshold_env))) : 0u;
+    const uint32_t canonical_profile = 0;
+
+
+    const bool reverse_parity = false;
