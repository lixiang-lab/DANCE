+    if (value == nullptr || std::string(value).empty())
+        return default_value;
+    long parsed = std::strtol(value, nullptr, 10);
+    return parsed > 0 ? (uint32_t)parsed : default_value;
+}
+
+static std::vector<int> get_shard_build_devices(uint32_t parallelism)
+{
+    std::vector<int> devices;
+    const char *env = std::getenv("DISKANN_SHARD_BUILD_DEVICES");
+    if (env != nullptr && std::string(env).size() > 0)
+    {
+        std::stringstream ss(env);
+        std::string token;
+        while (std::getline(ss, token, ','))
+        {
+            if (!token.empty())
+                devices.push_back(std::atoi(token.c_str()));
+        }
+    }
+    if (devices.empty())
+    {
+        for (uint32_t i = 0; i < parallelism; i++)
+            devices.push_back((int)i);
+    }
+    return devices;
+}
