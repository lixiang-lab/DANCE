+__global__ void init_touched_from_active_kernel(uint32_t N,const uint8_t *__restrict__ active_nodes,uint8_t *__restrict__ touched_nodes)
+{
+    uint32_t node = blockIdx.x * blockDim.x + threadIdx.x;
