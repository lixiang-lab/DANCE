+static std::string shell_quote(const std::string &value)
+{
+    std::string quoted = "'";
+    for (char c : value)
+    {
+        if (c == '\'')
+            quoted += "'\\''";
+        else
+            quoted += c;
+    }
+    quoted += "'";
+    return quoted;
+}
+
+template <typename T>
+static int load_shard_data_from_ids_to_memory(const std::string &base_file,
+                                              const std::string &idmap_filename,
+                                              T *&data,
+                                              size_t &shard_size,
+                                              size_t &dim)
+{
+    const auto load_start = std::chrono::high_resolution_clock::now();
+    constexpr size_t direct_block_size = 5000000;
+    size_t read_blk_size = 64 * 1024 * 1024;
+
+    cached_ifstream base_reader(base_file, read_blk_size);
+    uint32_t npts32 = 0;
+    uint32_t basedim32 = 0;
+    base_reader.read((char *)&npts32, sizeof(uint32_t));
+    base_reader.read((char *)&basedim32, sizeof(uint32_t));
+    const size_t num_points = npts32;
+    dim = basedim32;
+
+    uint32_t *shard_ids = nullptr;
+    uint64_t tmp = 0;
+    diskann::load_bin<uint32_t>(idmap_filename, shard_ids, shard_size, tmp);
+    if (tmp != 1)
+    {
+        delete[] shard_ids;
+        std::cerr << "[GPU direct shard] idmap must have dim=1: "
+                  << idmap_filename << std::endl;
+        return -1;
+    }
+
+    data = new T[shard_size * dim];
+    uint32_t cur_pos = 0;
+    uint32_t num_loaded = 0;
+    diskann::cout << "[GPU direct shard] shard has " << shard_size
+                  << " points from idmap=" << idmap_filename << std::endl;
+
+    const size_t block_size = num_points <= direct_block_size ? num_points : direct_block_size;
+    std::unique_ptr<T[]> block_data = std::make_unique<T[]>(block_size * dim);
+    const size_t num_blocks = DIV_ROUND_UP(num_points, block_size);
+
+    for (size_t block = 0; block < num_blocks; block++)
+    {
+        const size_t start_id = block * block_size;
+        const size_t end_id = (std::min)((block + 1) * block_size, num_points);
+        const size_t cur_blk_size = end_id - start_id;
+
+        base_reader.read((char *)block_data.get(), sizeof(T) * cur_blk_size * dim);
+
+        for (size_t p = 0; p < cur_blk_size; p++)
+        {
+            const uint32_t original_point_map_id = (uint32_t)(start_id + p);
+            if (cur_pos == shard_size)
+                break;
+            if (original_point_map_id == shard_ids[cur_pos])
+            {
+                std::memcpy(data + (size_t)num_loaded * dim,
+                            block_data.get() + p * dim,
+                            sizeof(T) * dim);
+                cur_pos++;
+                num_loaded++;
+            }
+        }
+        if (cur_pos == shard_size)
+            break;
+    }
+
+    delete[] shard_ids;
+
+    if (num_loaded != shard_size)
+    {
+        delete[] data;
+        data = nullptr;
+        std::cerr << "[GPU direct shard] loaded " << num_loaded
+                  << " points but expected " << shard_size
+                  << " from " << idmap_filename << std::endl;
+        return -1;
+    }
+
+    const auto load_end = std::chrono::high_resolution_clock::now();
+    const std::chrono::duration<double> load_seconds = load_end - load_start;
+    diskann::cout << "[gpu_direct_shard_timing]"
+                  << " idmap=" << idmap_filename
+                  << " npts=" << shard_size
+                  << " dim=" << dim
+                  << " load_seconds=" << load_seconds.count()
+                  << " subshard_file_written=0"
+                  << std::endl;
+
+    return 0;
+}
