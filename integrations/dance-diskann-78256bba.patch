+#elif defined(VAMANA_ALPHA_FINAL_FROM_ITER)
+    (void)iters;
+    return iter >= (uint32_t)VAMANA_ALPHA_FINAL_FROM_ITER ? (float)VAMANA_ALPHA : 1.0f;
+#else
+    return (iter + 1 >= iters) ? (float)VAMANA_ALPHA : 1.0f;
+#endif
+}
