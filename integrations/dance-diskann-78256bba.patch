+extern "C" int gpu_vamana_build(const uint8_t *h_data,uint32_t num_points,uint32_t dim,uint32_t R,uint32_t L,uint32_t C,uint32_t STEPS,uint32_t *h_graph,uint32_t *h_degree)
+{
