+    float *dist_row = graph_dists + base;
+
+    uint32_t deg = degree_next[node];
+
+    if (deg > C)
+        deg = C;
+
+    int same_pos = find_id_pos_R_warp(row,deg,C,x,lane);
+
+    if (same_pos >= 0)
+        return;
+
+    int occluded = 0;
+
+    for (uint32_t i = 0; i < deg; i++)
+    {
+        uint32_t y = row[i];
+
+        if (y == INVALID_ID || y >= N || y == node)
