+#endif
+        CUDA_CHECK(cudaGetLastError());
+        CUDA_CHECK(cudaMemcpy(&g_last_gpu_vamana_stats.selective_active_nodes,d_important_count,sizeof(uint32_t),cudaMemcpyDeviceToHost));
+
