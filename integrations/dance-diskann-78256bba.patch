+    }
+    else
+    {
+#if ENABLE_NODE_VECTOR_REG_CACHE
+        if (dim == (uint32_t)CacheDim && (dim & 1u) == 0)
+        {
+            constexpr uint32_t slots = (uint32_t)NODE_VECTOR_CACHE_HALF2_SLOTS(CacheDim);
