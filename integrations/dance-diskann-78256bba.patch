+        float dy = xv.y - yv.y;
+        float dz = xv.z - yv.z;
+        float dw = xv.w - yv.w;
+
+        sum += dx * dx + dy * dy + dz * dz + dw * dw;
+    }
+
+    for (int offset = 16; offset > 0; offset >>= 1)
+        sum += __shfl_down_sync(0xFFFFFFFF,sum,offset);
