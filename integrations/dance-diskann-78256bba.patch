+bool valid_pq_pivots_file(const std::string &pq_pivots_path, uint32_t num_centers, uint32_t dim,
+                          uint32_t num_pq_chunks, bool use_opq)
+{
+    if (!file_exists(pq_pivots_path))
+        return false;
+
+    try
+    {
+        size_t nr, nc;
+        std::unique_ptr<size_t[]> file_offset_data;
+        diskann::load_bin<size_t>(pq_pivots_path.c_str(), file_offset_data, nr, nc, 0);
+        if (nr != 4)
+            return false;
+
+        std::unique_ptr<float[]> pivot_data;
+        diskann::load_bin<float>(pq_pivots_path.c_str(), pivot_data, nr, nc, file_offset_data[0]);
+        if (nr != num_centers || nc != dim)
+            return false;
+
+        std::unique_ptr<float[]> centroid;
+        diskann::load_bin<float>(pq_pivots_path.c_str(), centroid, nr, nc, file_offset_data[1]);
+        if (nr != dim || nc != 1)
+            return false;
+
+        std::unique_ptr<uint32_t[]> chunk_offsets;
+        diskann::load_bin<uint32_t>(pq_pivots_path.c_str(), chunk_offsets, nr, nc, file_offset_data[2]);
+        if (nr != (uint64_t)num_pq_chunks + 1 || nc != 1)
+            return false;
+
+        if (use_opq)
+        {
+            std::string rotmat_path = pq_pivots_path + "_rotation_matrix.bin";
+            std::unique_ptr<float[]> rotmat_tr;
+            diskann::load_bin<float>(rotmat_path.c_str(), rotmat_tr, nr, nc);
+            if (nr != dim || nc != dim)
+                return false;
+        }
+    }
+    catch (...)
+    {
+        return false;
+    }
+
+    return true;
+}
+
+bool valid_pq_compressed_file(const std::string &pq_compressed_vectors_path, uint32_t num_points,
+                              uint32_t num_pq_chunks, uint32_t num_centers)
+{
+    if (!file_exists(pq_compressed_vectors_path))
+        return false;
+
+    std::ifstream reader(pq_compressed_vectors_path, std::ios::binary);
+    if (!reader.is_open())
+        return false;
+
+    uint32_t file_num_points = 0;
+    uint32_t file_num_pq_chunks = 0;
+    reader.read((char *)&file_num_points, sizeof(uint32_t));
+    reader.read((char *)&file_num_pq_chunks, sizeof(uint32_t));
+    if (!reader || file_num_points != num_points || file_num_pq_chunks != num_pq_chunks)
+        return false;
+
+    const size_t bytes_per_code = num_centers > 256 ? sizeof(uint32_t) : sizeof(uint8_t);
+    const size_t expected_size =
+        2 * sizeof(uint32_t) + (size_t)num_points * (size_t)num_pq_chunks * bytes_per_code;
+    return get_file_size(pq_compressed_vectors_path) == expected_size;
+}
