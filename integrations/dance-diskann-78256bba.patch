index 60e38c1b..d87a107f 100644
--- a/apps/build_stitched_index.cpp
+++ b/apps/build_stitched_index.cpp
@@ -23,6 +23,119 @@
 namespace po = boost::program_options;
 typedef std::tuple<std::vector<std::vector<uint32_t>>, uint64_t> stitch_indices_return_values;
 
+static std::string trim_label_line(std::string line)
+{
+    while (!line.empty() && (line.back() == '\n' || line.back() == '\r' || line.back() == ' ' || line.back() == '\t'))
+        line.pop_back();
+    return line;
+}
+
+static bool parse_single_label_file_compact(
+    path label_data_path, const std::string &universal_label,
+    tsl::robin_map<std::string, uint32_t> &labels_to_number_of_points, label_set &all_labels,
+    tsl::robin_map<std::string, std::vector<uint32_t>> &label_id_to_orig_id_map, uint32_t &total_number_of_points)
+{
+    std::ifstream first(label_data_path);
+    if (!first)
+        throw std::runtime_error("Failed to open label file " + label_data_path);
+
+    std::string line;
+    uint32_t point_id = 0;
+    while (std::getline(first, line))
+    {
+        line = trim_label_line(line);
+        if (line.empty() || line == universal_label || line.find(',') != std::string::npos)
+            return false;
+        all_labels.insert(line);
+        labels_to_number_of_points[line]++;
+        point_id++;
+    }
+    total_number_of_points = point_id;
+
+    for (const auto &lbl : all_labels)
+        label_id_to_orig_id_map[lbl].reserve(labels_to_number_of_points[lbl]);
+
+    std::ifstream second(label_data_path);
+    point_id = 0;
+    while (std::getline(second, line))
+    {
+        line = trim_label_line(line);
+        label_id_to_orig_id_map[line].push_back(point_id);
+        point_id++;
+    }
+
+    std::cout << "Identified " << all_labels.size() << " distinct single label(s) for " << total_number_of_points
+              << " points using compact parser\n"
+              << std::endl;
+    return true;
+}
+
+template <typename T>
+static tsl::robin_map<std::string, std::vector<uint32_t>> generate_label_specific_vector_files_from_ids(
+    path input_data_path, const tsl::robin_map<std::string, uint32_t> &labels_to_number_of_points,
+    const tsl::robin_map<std::string, std::vector<uint32_t>> &label_id_to_orig_id_map, const label_set &all_labels)
+{
+    auto file_writing_timer = std::chrono::high_resolution_clock::now();
+    diskann::MemoryMapper input_data(input_data_path);
+    char *input_start = input_data.getBuf();
+
+    uint32_t number_of_points, dimension;
+    std::memcpy(&number_of_points, input_start, sizeof(uint32_t));
+    std::memcpy(&dimension, input_start + sizeof(uint32_t), sizeof(uint32_t));
+    const uint32_t vector_size = dimension * sizeof(T);
+    const size_t metadata = 2 * sizeof(uint32_t);
+
+    uint64_t mapped_points = 0;
+    for (const auto &lbl : all_labels)
+        mapped_points += label_id_to_orig_id_map.at(lbl).size();
+    if (mapped_points != number_of_points)
+        throw std::runtime_error("compact label id map point count mismatch");
+
+    std::vector<iovec> iovecs(IOV_MAX);
+    for (const auto &lbl : all_labels)
+    {
+        path curr_label_input_data_path(input_data_path + "_" + lbl);
+        uint32_t curr_num_pts = labels_to_number_of_points.at(lbl);
+        const auto &ids = label_id_to_orig_id_map.at(lbl);
+
+        int fd = open(curr_label_input_data_path.c_str(), O_CREAT | O_WRONLY | O_TRUNC, (mode_t)0644);
+        if (fd == -1)
+            throw std::runtime_error("failed to open label-specific vector file " + curr_label_input_data_path);
+
+        uint32_t header[2] = {curr_num_pts, dimension};
+        if (write(fd, header, sizeof(header)) == -1)
+        {
+            close(fd);
+            throw std::runtime_error("failed to write label-specific vector header");
+        }
+
+        size_t offset = 0;
+        while (offset < ids.size())
+        {
+            size_t batch = std::min<size_t>((size_t)IOV_MAX, ids.size() - offset);
+            for (size_t i = 0; i < batch; ++i)
+            {
+                uint32_t point_id = ids[offset + i];
+                iovecs[i].iov_base = input_start + metadata + ((size_t)vector_size * point_id);
+                iovecs[i].iov_len = vector_size;
+            }
+            if (writev(fd, iovecs.data(), (int)batch) == -1)
+            {
+                close(fd);
+                throw std::runtime_error("failed to write label-specific vectors");
+            }
+            offset += batch;
+        }
+        close(fd);
+    }
+
+    std::chrono::duration<double> file_writing_time = std::chrono::high_resolution_clock::now() - file_writing_timer;
+    std::cout << "generated " << all_labels.size()
+              << " compact single-label vector files for index building in time " << file_writing_time.count() << "\n"
+              << std::endl;
+    return label_id_to_orig_id_map;
+}
