+        return;
+    const size_t cur_base = (size_t)row * R;
+    const size_t work_base = (size_t)row * C;
+    uint32_t deg = degree_cur[row];
+    if (deg > R)
+        deg = R;
+    for (uint32_t i = 0; i < C; ++i)
