+////
+static int save_gpu_vamana_graph_for_merge(const std::string &graph_file,
+                                           const uint32_t *graph,
+                                           const uint32_t *degree,
+                                           uint32_t npts,
+                                           uint32_t width,
+                                           uint32_t medoid)
+{
+    uint64_t index_size =
+        sizeof(uint64_t) + sizeof(uint32_t) + sizeof(uint32_t) + sizeof(uint64_t);
+
+    for (uint32_t i = 0; i < npts; i++)
+    {
+        uint32_t deg = degree[i];
+        if (deg > width)
+            deg = width;
+
+        index_size += sizeof(uint32_t) + (uint64_t)deg * sizeof(uint32_t);
+    }
+
+    std::ofstream writer(graph_file, std::ios::binary);
+    if (!writer.is_open())
+    {
+        std::cerr << "[GPU shard] failed to open graph file: " << graph_file << std::endl;
+        return -1;
+    }
+
+    uint64_t frozen = 0;
+
+    writer.write((char *)&index_size, sizeof(uint64_t));
+    writer.write((char *)&width, sizeof(uint32_t));
+    writer.write((char *)&medoid, sizeof(uint32_t));
+    writer.write((char *)&frozen, sizeof(uint64_t));
+
+    for (uint32_t i = 0; i < npts; i++)
+    {
+        uint32_t deg = degree[i];
+        if (deg > width)
+            deg = width;
+
+        writer.write((char *)&deg, sizeof(uint32_t));
+
+        if (deg > 0)
+        {
+            writer.write((char *)(graph + (size_t)i * width),
+                         (size_t)deg * sizeof(uint32_t));
+        }
+    }
+
+    writer.close();
+
+    diskann::cout << "[GPU shard] saved graph: " << graph_file
+                  << " npts=" << npts
+                  << " width=" << width
+                  << " medoid=" << medoid
+                  << " bytes=" << index_size
+                  << std::endl;
+
+    return 0;
+}
+
+////
+#ifdef USE_GPU_VAMANA
+template <typename T>
+static int build_gpu_shard_index_from_data(const T *data,
+                                           size_t npts,
+                                           size_t dim,
+                                           const std::string &source_name,
+                                           const std::string &shard_index_file,
+                                           uint32_t shard_R,
+                                           uint32_t L,
+                                           uint32_t gpu_C,
+                                           uint32_t gpu_STEPS)
+{
+    if (data == nullptr || npts == 0 || dim == 0)
+    {
+        std::cerr << "[GPU shard] failed to load shard data: "
+                  << source_name << std::endl;
+        return -1;
+    }
+
