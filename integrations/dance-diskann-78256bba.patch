+                            thrust::raw_pointer_cast(d_out_neighbors_buf.data()));
+                    }
+                    else
+                    {
+                        top_r_hash_select_segments_kernel<<<num_segments, 1>>>(
+                            thrust::raw_pointer_cast(d_edges_buf.data()),
+                            thrust::raw_pointer_cast(d_segment_srcs_buf.data()),
